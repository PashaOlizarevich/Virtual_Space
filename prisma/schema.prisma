generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  BYN
}

model Category {
  id        BigInt    @id @default(autoincrement())
  slug      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([name, id])
}

model Product {
  id          BigInt    @id @default(autoincrement())
  categoryId  BigInt
  slug        String    @unique
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  currency    Currency  @default(BYN)
  stock       Int       @default(0)
  isActive    Boolean   @default(false)
  newFrom     DateTime? @db.Timestamptz(3)
  newUntil    DateTime? @db.Timestamptz(3)
  material    String
  style       String
  dimensions  String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  optionGroups   ProductOptionGroup[]

  @@index([categoryId, isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isActive, newFrom(sort: Desc), newUntil, id(sort: Desc)])
}

model ProductImage {
  id                 BigInt   @id @default(autoincrement())
  productId          BigInt
  cloudinaryPublicId String
  secureUrl          String
  alt                String
  position           Int
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@unique([cloudinaryPublicId])
}

model ProductSpecification {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  label     String
  value     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@unique([productId, position])
}

model ProductOptionGroup {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  key       String
  label     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@unique([productId, key])
  @@unique([productId, position])
}

model ProductOption {
  id        BigInt   @id @default(autoincrement())
  groupId   BigInt
  key       String
  label     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@unique([groupId, position])
}

model StoreSettings {
  id  BigInt @id @default(autoincrement())
  key String @unique @default("primary")
}
