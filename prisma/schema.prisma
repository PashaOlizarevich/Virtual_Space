generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  BYN
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  emailVerified DateTime?            @db.Timestamptz(3)
  image         String?
  phone         String?
  passwordHash  String?
  role          UserRole             @default(USER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  statusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
}

model Category {
  id        BigInt    @id @default(autoincrement())
  slug      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([name, id])
}

model Product {
  id          BigInt    @id @default(autoincrement())
  categoryId  BigInt
  slug        String    @unique
  name        String
  description String
  /// DB invariant for the order migration: price >= 0.
  price       Decimal   @db.Decimal(12, 2)
  currency    Currency  @default(BYN)
  /// DB invariant for the order migration: stock >= 0.
  stock       Int       @default(0)
  isActive    Boolean   @default(false)
  newFrom     DateTime? @db.Timestamptz(3)
  newUntil    DateTime? @db.Timestamptz(3)
  material    String
  style       String
  dimensions  String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  optionGroups   ProductOptionGroup[]
  orderItems     OrderItem[]

  @@index([categoryId, isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isActive, newFrom(sort: Desc), newUntil, id(sort: Desc)])
}

model ProductImage {
  id                 BigInt   @id @default(autoincrement())
  productId          BigInt
  cloudinaryPublicId String
  secureUrl          String
  alt                String
  position           Int
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@unique([cloudinaryPublicId])
}

model ProductSpecification {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  label     String
  value     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@unique([productId, position])
}

model ProductOptionGroup {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  key       String
  label     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@unique([productId, key])
  @@unique([productId, position])
}

model ProductOption {
  id        BigInt   @id @default(autoincrement())
  groupId   BigInt
  key       String
  label     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@unique([groupId, position])
}

model Order {
  id           BigInt      @id @default(autoincrement())
  publicNumber String      @unique
  userId       String?
  customerName String
  phone        String
  email        String
  comment      String?
  currency     Currency    @default(BYN)
  /// DB invariant for the order migration: total >= 0.
  total        Decimal     @db.Decimal(12, 2)
  status       OrderStatus @default(NEW)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt
  productId       BigInt?
  snapshotName    String
  snapshotOptions Json
  /// DB invariant for the order migration: snapshotPrice >= 0.
  snapshotPrice   Decimal  @db.Decimal(12, 2)
  /// DB invariant for the order migration: quantity > 0.
  quantity        Int
  /// DB invariants for the order migration: lineTotal >= 0 and lineTotal = snapshotPrice * quantity.
  lineTotal       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model OrderStatusHistory {
  id              BigInt      @id @default(autoincrement())
  orderId         BigInt
  previousStatus  OrderStatus
  newStatus       OrderStatus
  changedByUserId String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
}

model StoreSettings {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @default("primary")
  name        String
  description String
  contacts    Json
  socials     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}
