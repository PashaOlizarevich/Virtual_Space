generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id BigInt @id @default(autoincrement())
}

model Product {
  id BigInt @id @default(autoincrement())
}

model ProductImage {
  id BigInt @id @default(autoincrement())
}

model ProductSpecification {
  id BigInt @id @default(autoincrement())
}

model ProductOptionGroup {
  id BigInt @id @default(autoincrement())
}

model ProductOption {
  id BigInt @id @default(autoincrement())
}

model StoreSettings {
  id BigInt @id @default(autoincrement())
}
